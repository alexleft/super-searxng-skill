{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "super-searxng-skill request",
  "description": "JSON payload accepted by `searxng.py --stdin` (or piped to the PS/bash launcher).",
  "type": "object",
  "required": ["queries"],
  "properties": {
    "base_url": {
      "type": "string",
      "description": "SearXNG instance root URL. Defaults to $SEARXNG_URL or https://s.gba.fan/."
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["q"],
        "properties": {
          "q":               { "type": "string" },
          "category":        { "type": "string", "default": "general" },
          "language":        { "type": "string", "default": "all" },
          "page":            { "type": "integer", "minimum": 1, "default": 1 },
          "time_range":      { "type": "string", "enum": ["", "day", "week", "month", "year"], "default": "" },
          "safesearch":      { "type": "integer", "enum": [0, 1, 2], "default": 1 },
          "engines":         { "type": "string", "description": "Comma-separated engine names. Empty = use instance default pool + auto-fallback." },
          "allow_fallback":  { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "limit":                 { "type": "integer", "minimum": 1, "default": 10 },
    "merge":                 { "type": "boolean", "default": false, "description": "Deduplicate across queries by URL and tag each hit with its origin query." },
    "max_concurrency":       { "type": "integer", "minimum": 1, "maximum": 12, "default": 4 },
    "timeout_sec":           { "type": "integer", "minimum": 1, "default": 25 },
    "fallback_engines":      { "type": "string", "default": "bing,yandex,sogou,duckduckgo,mdn,stackoverflow,wikipedia" },
    "no_fallback_engines":   { "type": "boolean", "default": false },
    "raw":                   { "type": "boolean", "default": false, "description": "Emit JSON instead of Markdown." }
  },
  "additionalProperties": false
}
